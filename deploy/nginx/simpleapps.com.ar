# simpleapps.com.ar — nginx nativo del sistema (no Docker).
# Instalado en /etc/nginx/sites-available/simpleapps.com.ar por deploy/install.sh
#
# root = /var/www/simpleapps.com.ar (NO /usr/share/nginx/html: ese lo sobreescribe
# el paquete nginx-common en cada actualizacion con la pagina "Welcome to nginx!").

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name simpleapps.com.ar www.simpleapps.com.ar vps-4740477-x.dattaweb.com localhost;

    root /var/www/simpleapps.com.ar;
    index index.html;

    # Challenge de Let's Encrypt (authenticator webroot: no hace falta parar nginx)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/xml image/svg+xml;
    gzip_disable "MSIE [1-6]\.";

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000";
        access_log off;
    }
}

server {
    listen 443 ssl default_server;
    server_name simpleapps.com.ar www.simpleapps.com.ar;

    ssl_certificate /etc/letsencrypt/live/simpleapps.com.ar/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/simpleapps.com.ar/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    root /var/www/simpleapps.com.ar;
    index index.html;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/xml image/svg+xml;
    gzip_disable "MSIE [1-6]\.";

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000";
        access_log off;
    }
}
